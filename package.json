{
  "name": "game-mechanics-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/next-build.mjs",
    "build:pages": "node scripts/next-build.mjs --pages",
    "start": "node scripts/static-preview.mjs",
    "preview": "node scripts/static-preview.mjs",
    "preview:pages": "node scripts/static-preview.mjs --base-path=/game-mechanics-atlas",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:readlink": "node --test scripts/readlink-compat.test.mjs",
    "test:static": "node --test scripts/static-preview.test.mjs",
    "test:agent-data": "node --test scripts/export-agent-data.test.mjs",
    "check:coverage": "node scripts/check-catalog-coverage.mjs",
    "export:agent-data": "node --import ./scripts/register-typescript.mjs scripts/export-agent-data.mjs",
    "test:e2e": "playwright test",
    "preview:design": "node scripts/serve-design.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
